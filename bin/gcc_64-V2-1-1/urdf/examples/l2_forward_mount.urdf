<?xml version="1.0"?>
<!--
  Minimal example URDF: Unitree L2 mounted on the FRONT face of a trivial
  "robot", facing forward with cable pointing down. Use with
  l2_forward_mount_example.launch.py.

  Robot geometry (identical to l2_top_mount.urdf — only the L2 joint differs):
    base_link: 200 mm cube on the ground.
    top_block: 100 mm cube on top of the base.

  L2 mount:
    l2lidar_link at the center of the top_block's front face (+X side).
    Rotation rpy = (π, -π/2, 0) reorients the L2 so:
      L2 +Z (cloud out of mount surface)  → world +X (forward)
      L2 +X (opposite cable exit)         → world +Z (up — cable points DOWN)
      L2 +Y                               → world -Y
    The L2 mesh visibly hangs off the front face with cable side down.

  This is the typical mobile-robot mounting orientation (forward scanning,
  cable routed downward into the body).
-->
<robot name="l2_forward_mount_example">

  <!-- 200mm base cube, sitting on the ground -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
      <material name="base_blue">
        <color rgba="0.20 0.40 0.80 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- 100mm top cube, sitting flush on the base cube -->
  <link name="top_block">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="top_gray">
        <color rgba="0.50 0.50 0.50 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_top" type="fixed">
    <parent link="base_link"/>
    <child  link="top_block"/>
    <!-- top of the 200mm base cube -->
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>

  <!-- L2 device link. Mesh origin = device's bottom mounting surface center,
       which is the cloud frame origin (Unitree spec). -->
  <link name="l2lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://l2lidar_node/meshes/l2_lidar.stl"/>
      </geometry>
      <material name="l2_dark">
        <color rgba="0.10 0.10 0.10 1.0"/>
      </material>
    </visual>
  </link>

  <!-- L2 mounted on the front face of top_block (+X side), cable-down
       forward-looking convention.
       xyz=(0.05, 0, 0.05): top_block extends from x=-0.05..+0.05; its front
         face center is at (0.05, 0, 0.05) in top_block frame.
       rpy=(π, -π/2, 0) ≈ (3.14159, -1.5708, 0): see file header for axis
         mapping. Numeric values used because plain URDF doesn't expand ${pi}. -->
  <joint name="top_to_l2" type="fixed">
    <parent link="top_block"/>
    <child  link="l2lidar_link"/>
    <origin xyz="0.05 0 0.05" rpy="3.14159 -1.5708 0"/>
  </joint>

</robot>
