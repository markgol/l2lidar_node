<?xml version="1.0"?>
<!--
  Minimal example URDF: Unitree L2 mounted on top of a trivial "robot".
  Use with l2_top_mount_example.launch.py.

  Robot geometry:
    base_link: 200 mm cube, sitting on the ground (bottom at z=0, top at z=0.20)
    top_block: 100 mm cube, sitting on top of the base (bottom at z=0.20, top at z=0.30)

  L2 mount:
    l2lidar_link: device origin sits flat on the top face of top_block (z=0.30).
    The L2 mesh extends from z=0.30 to z≈0.364 (the device is ~64 mm tall).

  Frame conventions (per Unitree spec):
    L2 +Z = out of the bottom mounting surface (the scan / cloud direction).
    L2 +X = opposite the cable exit.
    L2 +Y = right-hand rule from +X, +Z.

  In the top-mount variant the L2's +Z (cloud) points world +Z (up). Useful
  when you want overhead / ceiling-facing coverage, or as a benchtop test rig.
-->
<robot name="l2_top_mount_example">

  <!-- 200mm base cube, sitting on the ground -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
      <material name="base_blue">
        <color rgba="0.20 0.40 0.80 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
    </collision>
  </link>

  <!-- 100mm top cube, sitting flush on the base cube -->
  <link name="top_block">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="top_gray">
        <color rgba="0.50 0.50 0.50 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_top" type="fixed">
    <parent link="base_link"/>
    <child  link="top_block"/>
    <!-- top of the 200mm base cube -->
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>

  <!-- L2 device link. The driver publishes cloud header.frame_id and the
       cloud→imu static TF anchored here. Mesh origin matches the cloud
       frame: bottom of mesh sits at this link's origin, mesh extends in
       +Z (away from the robot in the top-mount variant). -->
  <link name="l2lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://l2lidar_node/meshes/l2_lidar.stl"/>
      </geometry>
      <material name="l2_dark">
        <color rgba="0.10 0.10 0.10 1.0"/>
      </material>
    </visual>
  </link>

  <!-- L2 mounted on the top face of top_block. No rotation: L2 +Z (cloud
       out of mount) points world +Z. -->
  <joint name="top_to_l2" type="fixed">
    <parent link="top_block"/>
    <child  link="l2lidar_link"/>
    <!-- center of the top face of the 100mm top cube -->
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

</robot>
